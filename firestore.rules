rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.resource.data.userId == request.auth.uid);
    }

    // RFQ inquiries
    match /rfqs/{rfqId} {
      allow read: if true;
      allow create, update: if true; // allow buyers to submit RFQs
      allow delete: if request.auth != null;
    }

    // Sample Orders
    match /samples/{sampleId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // AI Assistant Queries & Conversation logs
    match /ai_inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Federated Catalog products
    match /federated_catalog/{productId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Live System Metrics
    match /system_metrics/{metricId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
