{
  "entities": {
    "User": {
      "collection": "users",
      "fields": {
        "userId": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "companyName": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "verified": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "Rfq": {
      "collection": "rfqs",
      "fields": {
        "buyerName": { "type": "string" },
        "companyName": { "type": "string" },
        "productRequirement": { "type": "string" },
        "targetQuantity": { "type": "number" },
        "targetUnitPriceUSD": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Sample": {
      "collection": "samples",
      "fields": {
        "productId": { "type": "string" },
        "productTitle": { "type": "string" },
        "supplierName": { "type": "string" },
        "quantity": { "type": "number" },
        "status": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "AiInquiry": {
      "collection": "ai_inquiries",
      "fields": {
        "userId": { "type": "string" },
        "query": { "type": "string" },
        "response": { "type": "string" },
        "contextType": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "FederatedProduct": {
      "collection": "federated_catalog",
      "fields": {
        "sku": { "type": "string" },
        "title": { "type": "string", "required": true },
        "categoryId": { "type": "string" },
        "moq": { "type": "number" },
        "baseRetailPrice": { "type": "number" },
        "supplierName": { "type": "string" },
        "publishedAt": { "type": "string" }
      }
    },
    "SystemMetric": {
      "collection": "system_metrics",
      "fields": {
        "activeBuyers": { "type": "number" },
        "verifiedSuppliers": { "type": "number" },
        "totalTradeVol": { "type": "string" },
        "bdtSalesVolume": { "type": "string" }
      }
    },
    "RfqThread": {
      "collection": "rfq_threads",
      "fields": {
        "sourceNode": { "type": "string", "required": true },
        "createdAt": { "type": "timestamp" },
        "status": { "type": "string", "required": true },
        "buyer": { "type": "map", "required": true },
        "product": { "type": "map", "required": true },
        "requestDetails": { "type": "map", "required": true },
        "audit": { "type": "map", "required": true }
      }
    }
  }
}
